s="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Can I attend </w:t></w:r><w:r w:rsidR="00523880"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">the Open Day </w:t></w:r><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>if I'm still in high school?</w:t></w:r></w:p><w:p w14:paraId="19D533B3" w14:textId="6632D0BA" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">Yes. Open Day is ideal for learners who are considering their study options and want to learn more about careers in technology. </w:t></w:r></w:p><w:p w14:paraId="232D12E6" w14:textId="77777777" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>My child is interested in IT. Can I attend with them?</w:t></w:r></w:p><w:p w14:paraId="133AD63A" w14:textId="467E5326" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">Yes. Parents are encouraged to attend so they can learn more about qualifications, career opportunities, admissions, and funding options. </w:t></w:r></w:p><w:p w14:paraId="53392C49" w14:textId="77777777" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>What if I'm not sure which IT qualification is right for me?</w:t></w:r></w:p><w:p w14:paraId="5364D5B8" w14:textId="68D4E678" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">That's exactly what Open Day is for. Our team can help you understand the different study paths and identify the qualification that best matches your interests and career goals. </w:t></w:r></w:p><w:p w14:paraId="4FF85030" w14:textId="2D815C8A" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>Can I get help with applications?</w:t></w:r></w:p><w:p w14:paraId="042928D8" w14:textId="66DBB1C1" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="002F2E96"><w:pPr><w:pStyle w:val="ListParagraph"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">Yes. Our admissions team can assist with your application and provide guidance on available </w:t></w:r><w:r w:rsidRPr="0020351B"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:highlight w:val="yellow"/></w:rPr><w:t>funding options</w:t></w:r><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve"> and processes. </w:t></w:r><w:r w:rsidR="00727392"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>– I am a bit apprehensive to speak to funding, this is probably also why people think we are to an extent free.</w:t></w:r></w:p><w:p w14:paraId="3A108D0F" w14:textId="77777777" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="00C16FA9"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="10"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>What if I can't attend in person?</w:t></w:r></w:p><w:p w14:paraId="280040D5" w14:textId="26FD2D83" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00C16FA9" w:rsidP="002F2E96"><w:pPr><w:pStyle w:val="ListParagraph"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r w:rsidRPr="00C16FA9"><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">You can attend Open Day online and still explore your study options and engage with the Belgium Campus team. </w:t></w:r></w:p><w:p w14:paraId="2CC3F0B0" w14:textId="77777777" w:rsidR="00C16FA9" w:rsidRPr="00C16FA9" w:rsidRDefault="00000000" w:rsidP="00C16FA9"><w:pPr><w:rPr><w:rFonts w:asc